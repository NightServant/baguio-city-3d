# ---------------------------------------------------------------------------
# Option A — local Postgres + PostGIS via docker-compose (default)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://baguio:baguio@localhost:5432/baguio?schema=public"

# ---------------------------------------------------------------------------
# Option B — Supabase (hosted Postgres + PostGIS)
#
# Copy both strings from: Supabase dashboard -> Project Settings -> Database ->
# Connection string. DATABASE_URL is the pooled "Transaction" string (port 6543)
# used by the app at runtime; DIRECT_URL is the direct/session string (port 5432)
# used by Prisma Migrate, which cannot run DDL through PgBouncer.
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
# ---------------------------------------------------------------------------

# Redis — not provided by Supabase; keep the docker-compose service (or point
# this at any managed Redis). Caching degrades gracefully if unreachable.
REDIS_URL="redis://localhost:6379"

# Map engine: MapLibre GL + OpenFreeMap tiles + AWS Terrarium terrain.
# No account, API key, or access token required.

# Canonical origin for share links, canonical tags and the sitemap. Leave unset
# on Vercel: VERCEL_PROJECT_PRODUCTION_URL is used automatically.
# NEXT_PUBLIC_SITE_URL="https://your-domain"

# Shown in the footer and privacy policy. Hidden while unset.
# NEXT_PUBLIC_CONTACT_EMAIL=""
# Automated corrections (app/api/corrections/sweep, lib/corrections). Production only, Sensitive in Vercel.
# CORRECTIONS_MODEL="anthropic/claude-haiku-5.5"   # an AI Gateway model id; unset = reports wait for a person
# CORRECTIONS_SWEEP_TOKEN=""                        # openssl rand -hex 32; the cron sends it as a Bearer token
# AI_GATEWAY_API_KEY=""                             # local runs only; on Vercel the gateway authenticates by OIDC
# The reply to a reporter, from the owner's Gmail over SMTP (lib/corrections/db.ts). Unset = replies wait.
# GMAIL_USER="baguioadmin@gmail.com"
# GMAIL_APP_PASSWORD=""                              # Google Account -> Security -> App passwords (needs 2-Step Verification)
